# Telegram bridge config for a HOST run (router.py directly, dev/no-Docker).
# For the Docker stack service, configure the repo's ROOT .env instead (see .env.example
# there, the `--profile bridge` section). Copy this to bridge/telegram/.env and fill in.

# From @BotFather (/newbot; username must end in "bot"). Stays in the bridge only; it is
# stripped from the agent's environment.
TELEGRAM_BOT_TOKEN=123456:AA-your-botfather-token

# Admin panel token. Generate with: openssl rand -hex 16. Panel is disabled if unset.
TG_ADMIN_TOKEN=

# Numeric Telegram user ids seeded into the allowlist on first run (comma-separated).
# After that, edit the live allowlist from the panel. Default-deny: empty = nobody.
TG_ALLOWED_IDS=

# Active agent at first run: codex (OpenAI/ChatGPT) or agy (Google Gemini). Switchable live.
# Auth for each is set up OUTSIDE the bridge; it just runs the CLI (must be on PATH here).
DEFAULT_AGENT=codex

# Run the agent from the repo so `cli/censurado.py` resolves and it reads the operator skill.
REPO_DIR=/home/you/workspace/censurado-web-brain

# Writable dir for the live config (agent + allowlist), sessions, and per-chat scratch.
DATA_DIR=/home/you/.local/state/censurado-tg-bridge

# Admin panel bind (localhost) + port. Reach it at http://127.0.0.1:8090/?token=<TG_ADMIN_TOKEN>
TG_ADMIN_HOST=127.0.0.1
TG_PANEL_PORT=8090

# Optional: hard per-turn timeout, and template overrides (defaults are sensible).
AGENT_TIMEOUT=600
# AGENT_CMD_CODEX=codex exec -c model_reasoning_effort=low --dangerously-bypass-approvals-and-sandbox {msg}
# AGENT_CMD_AGY=agy --add-dir {repo} --dangerously-skip-permissions -p {msg}
# AGENT_SYSTEM=... (override the default Telegram-mode + operator preamble)

LOG_LEVEL=INFO
