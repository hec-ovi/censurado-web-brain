{
  "repoRoot": "../..",
  "bridge": {
    "dir": "../../../telegram-bot-skill",
    "startCmd": ["node", "src/bot.ts"],
    "adapter": "claude-code",
    "stateFile": "bot-state.json",
    "envFile": ".env",
    "envCascade": ["TELEGRAM_BOT_TOKEN", "OWNER_ID"],
    "graceMs": 10000
  },
  "docker": {
    "checkCmd": ["python3", "cli/censurado.py", "status"],
    "checkTimeoutMs": 30000,
    "upCmd": ["docker", "compose", "up", "-d", "publish", "generate", "site", "executor"],
    "upTimeoutMs": 300000
  },
  "intervals": { "dockerCheckMs": 60000 },
  "restartBudget": { "max": 5, "windowMs": 1800000 },
  "notify": true,
  "logFile": "../logs/serve.log",
  "lockFile": "../logs/.serve.lock"
}
