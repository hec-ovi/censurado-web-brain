# systemd unit for the 24/7 serve loop. Install (adjust the two paths):
#
#   sudo cp automation/supervisor/censurado-serve.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now censurado-serve
#
# Runs as your user, not root: docker access and the chain's agent CLIs live
# in your account. journalctl -u censurado-serve follows the log;
# automation/logs/serve.log keeps a copy on disk.

[Unit]
Description=Censurado serve loop (docker stack + telegram bridge + agent fallback chain)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=hec
WorkingDirectory=/home/hec/workspace/censurado-web-brain
ExecStart=/usr/bin/env node automation/supervisor/serve.mjs
Restart=always
RestartSec=10
# The agent CLIs live in the user's ~/.local/bin.
Environment=PATH=/home/hec/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
