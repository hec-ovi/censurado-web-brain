{
  "run_dir": "runs",
  "backend": { "base_url": "http://127.0.0.1:8082", "token_env": "NEWSROOM_OPERATOR_TOKEN" },
  "adapters": {
    "api": {
      "base_url": "http://127.0.0.1:8080/v1",
      "model": "qwen3.6-35b-a3b-heretic-q8",
      "system": "/no_think Sos parte de la redaccion del portal Censurado. Tu respuesta es directamente el contenido pedido, listo para usar.",
      "timeout_s": 300
    },
    "cli": { "cmd": ["claude", "-p", "{prompt}"], "timeout_s": 3600 }
  },
  "websearch": { "cmd": ["websearch"], "timeout_s": 180 },
  "nodes": [
    { "name": "queries", "adapter": "api", "output": "json", "prompt": "prompts/queries.md",
      "context": { "persona": { "persona": true },
                   "titulares": { "feeds": { "hours": 48, "max_per_source": 6 } } } },
    { "name": "ledger", "adapter": "api", "output": "text", "prompt": "prompts/ledger.md",
      "context": { "web": { "websearch": { "queries_from": "queries", "urls_from": "queries",
                                           "max_results": 5, "fetch_top": 4,
                                           "fetch_urls_top": 3 } } } },
    { "name": "outline", "adapter": "api", "output": "text", "prompt": "prompts/outline.md" },
    { "name": "draft", "adapter": "api", "output": "json", "prompt": "prompts/draft.md",
      "context": { "persona": { "persona": true },
                   "reglas": { "editorial": "es" } } },
    { "name": "evaluate", "adapter": "api", "role": "gate", "output": "json", "prompt": "prompts/evaluate.md",
      "context": { "persona": { "persona": true } },
      "respin": { "prompt": "prompts/respin.md", "target": "draft", "passes": 2 } },
    { "name": "finalize", "adapter": "api", "role": "draft", "output": "json", "prompt": "prompts/finalize.md",
      "context": { "reglas": { "editorial": "es" } } }
  ]
}
