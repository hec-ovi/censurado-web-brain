# Keep the build context small and reproducible. The brain image copies only
# pyproject/uv.lock/README + newsroom/testkit/prompts; everything below is dev-only,
# the frontend's own build context, or generated state that must not leak into the image.
.git
.venv
.pytest_cache
.ruff_cache
**/__pycache__
*.egg-info
data
*.db
*.db-wal
*.db-shm
tests
frontend
docs
deploy
CHANGELOG.md
