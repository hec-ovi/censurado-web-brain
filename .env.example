# censurado-web-brain configuration (prefix NEWSROOM_). Copy to .env and edit.
# There is deliberately NO output-length setting: the harness never caps a single
# generation's length. The bounds below are LOOP bounds, not output caps.

NEWSROOM_HOST=127.0.0.1
NEWSROOM_PORT=8722

# Local inference backend (OpenAI Chat-Completions dialect), e.g. llama.cpp/Vulkan.
NEWSROOM_INFERENCE_BASE_URL=http://127.0.0.1:8080/v1

# Platform publish seam. The operator token MUST hold BOTH scopes:
#   articles:write AND articles:publish-any
NEWSROOM_PUBLISH_BASE_URL=http://127.0.0.1:8080
NEWSROOM_OPERATOR_TOKEN=

# Brain-owned stores / assets.
NEWSROOM_PERSONA_DB_PATH=data/personas.db
NEWSROOM_PROMPTS_DIR=prompts

# Imagery seam: the art director renders a hero image per article on a local ComfyUI
# (FLUX.2 klein) and uploads it to the platform's media endpoint. Image size/steps are
# render parameters, NOT output-length caps. Set AUTO_GENERATE_IMAGE=false for text-only
# by default (a run can still override with --images / the per-run images flag).
NEWSROOM_COMFYUI_BASE_URL=http://127.0.0.1:8188
NEWSROOM_AUTO_GENERATE_IMAGE=true
NEWSROOM_IMAGE_WIDTH=1024
NEWSROOM_IMAGE_HEIGHT=1024
NEWSROOM_IMAGE_STEPS=4
NEWSROOM_REFERENCE_IMAGE_LIMIT=2
# Where generated images are uploaded (POST /media). Defaults to NEWSROOM_PUBLISH_BASE_URL.
# NEWSROOM_MEDIA_BASE_URL=

# Loop bounds (iteration counts and a shared per-article budget; NOT output caps).
NEWSROOM_N_MAX=4
NEWSROOM_EXPRESS_N=2  # express mode's default small batch (still clamped to N_MAX)
NEWSROOM_MAX_SWEEPS=4
NEWSROOM_MAX_MANAGER_STEPS=8
NEWSROOM_MAX_RESEARCH_STEPS=6
NEWSROOM_RESEARCH_STALL_LIMIT=2

# Drift test: where to find the live platform schema to compare against.
# Defaults to the sibling censurado-web repo when unset.
# NEWSROOM_PLATFORM_SCHEMA=../censurado-web/contracts/article.schema.json
