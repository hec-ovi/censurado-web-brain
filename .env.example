# censurado-web-brain configuration (prefix NEWSROOM_). Copy to .env and edit.
# The brain runs no model: it stores the newsroom config (authors, sources,
# prompts, editorial style) and serves it to the operator console and a CLI agent.
# There is deliberately NO output-length setting anywhere.

NEWSROOM_HOST=127.0.0.1
NEWSROOM_PORT=8722
# Browser CORS allow-list for the brain API, comma-separated (or * for any origin), so a
# browser admin/mobile-web client served from another origin clears the preflight. Default
# is the local dev origins (localhost:5173/3000/8722). A bare * drops credentialed CORS.
# NEWSROOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Brain-owned stores / assets.
NEWSROOM_PERSONA_DB_PATH=data/personas.db
NEWSROOM_PROMPTS_DIR=prompts

# Presentation defaults for a fresh box (seeded into the location row on bootstrap;
# not author data, just where/what-language the publication is).
NEWSROOM_DEFAULT_REGION=AR
NEWSROOM_DEFAULT_UI_LANG=es-419
NEWSROOM_DEFAULT_LANGUAGE=es
NEWSROOM_DEFAULT_GDELT_COUNTRY=AR

# Platform publish seam (used by the bootstrap author-reconcile and the publish
# transport). The operator token MUST hold articles:write + articles:publish-any + admin:write.
NEWSROOM_PUBLISH_BASE_URL=http://127.0.0.1:8080
NEWSROOM_OPERATOR_TOKEN=
# NEWSROOM_ADMIN_TOKEN=   # optional; the console admin token, separate from the operator key

# Imagery: an operator or a script can render a hero image on a local ComfyUI (FLUX.2
# klein) and upload it. Image size and steps are render parameters, NOT output-length caps.
NEWSROOM_COMFYUI_BASE_URL=http://127.0.0.1:8188
NEWSROOM_IMAGE_WIDTH=1024
NEWSROOM_IMAGE_HEIGHT=1024
NEWSROOM_IMAGE_STEPS=4
# Where generated images are uploaded (POST /media). Defaults to NEWSROOM_PUBLISH_BASE_URL.
# NEWSROOM_MEDIA_BASE_URL=

# Drift test: where to find the live platform schema to compare against.
# Defaults to the sibling censurado-web repo when unset.
# NEWSROOM_PLATFORM_SCHEMA=../censurado-web/contracts/article.schema.json
