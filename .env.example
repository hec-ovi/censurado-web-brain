# censurado configuration. Copy to .env (cp .env.example .env), then run
# ./bootstrap.sh to mint and fill the secrets. The non-secret defaults below are
# the reference Strix Halo box; edit them for your machine.

# --- GPU (Strix Halo / gfx1151) ----------------------------------------------
# Group IDs so the comfyui container can reach /dev/dri and /dev/kfd:
#   getent group render | cut -d: -f3   -> RENDER_GID
#   getent group video  | cut -d: -f3   -> VIDEO_GID
RENDER_GID=990
VIDEO_GID=44

# --- comfyui (image generation; renders the hero images) --------------------
COMFYUI_MODELS_PATH=/home/hec/models/comfyui

# --- public base url ---------------------------------------------------------
# Absolute origin baked into the generated static site's links. Match where the
# public site is actually served (SITE_PORT below).
CENSURADO_BASE_URL=http://localhost:8080

# --- operational data location -----------------------------------------------
# Runtime state: this ONE dir holds the backend's sqlite db (<dir>/db) and the
# uploaded images (<dir>/media). Defaults to ./data INSIDE this repo (gitignored, so
# the tracked code still carries no database). Set an absolute path to move it, but
# do NOT point it at a parent folder: keep the data inside the repo.
# CENSURADO_DATA_DIR=./data

# --- deploy to the live site (Cloudflare Pages) ------------------------------
# `make deploy` (deploy/deploy-cdn.sh) needs your Cloudflare account id. It is an
# identifier (not a credential; wrangler auths over OAuth via `wrangler login`), but it
# stays out of the public repo, so set it here. Find it in the dashboard URL. The Pages
# project and the production origin default to elcensuradoweb; override only if you fork
# the deploy target. Leave empty if you do not deploy.
CLOUDFLARE_ACCOUNT_ID=
# DEPLOY_PROJECT=elcensuradoweb
# DEPLOY_BASE_URL=https://elcensuradoweb.com
# PAGE_SIZE=6   # articles per listing page in the deployed snapshot (deploy-cdn.sh; default 6)

# --- article reactions (like/dislike; Cloudflare Pages Function + D1) --------
# functions/api/reactions.js serves GET/POST /api/reactions on the LIVE site, one
# vote per article per IP (the D1 row key is sha256(REACTIONS_SALT + client IP)).
# One-time setup: `npx wrangler d1 create censurado-reactions`, then paste the
# returned database_id below. deploy/deploy-cdn.sh regenerates wrangler.toml from
# these on every deploy (the file is gitignored; no migration step, the function
# creates its table). Leave D1_REACTIONS_ID empty to deploy without reactions:
# the article bar simply stays hidden. Pick any random string as the salt and
# KEEP IT STABLE: rotating it lets every IP vote again.
D1_REACTIONS_ID=
# D1_REACTIONS_NAME=censurado-reactions
REACTIONS_SALT=
# REACTIONS_MAX_PER_IP=500   # per-voter row cap the function enforces (default 500)

# --- host ports --------------------------------------------------------------
# Only SITE_PORT is exposed on 0.0.0.0; the rest bind 127.0.0.1 (set in compose).
SITE_PORT=8080      # public news portal
PUBLISH_PORT=8082   # write API + operator admin panel (127.0.0.1)
COMFYUI_PORT=8188   # ComfyUI UI

# --- secrets (filled by ./bootstrap.sh; do not hand-edit unless you know why) -
# The operator key on the platform (scopes: write + publish-any + admin:write). The CLI
# uses it to publish articles and to read/write authors + sources over HTTP; the folded-in
# panel needs no token (a browser session maps to the operator identity inside the backend).
NEWSROOM_OPERATOR_TOKEN=
# Operator panel login (served by publish at 127.0.0.1:8082): localhost-only, so the
# clear token is kept for login prefill. The SHA-256 hash still gates access, and the
# session key signs the login cookie. bootstrap.sh writes a matching hash.
PANEL_LOGIN_TOKEN=admin
PANEL_LOGIN_TOKEN_HASH=
PANEL_SESSION_KEY=
# Keep false for plain-HTTP localhost; set true behind HTTPS / a tunnel.
PANEL_SECURE_COOKIES=false

# --- newsroom sweeps (censurado-brain topics cleanse / embeds recheck / status) --
# The maintenance CLI (a thin newsroom/ entry point over the SAME backend) reads these.
# Both are optional: the backend base defaults to the write API below, and the edit key
# falls back to NEWSROOM_OPERATOR_TOKEN when unset.
# NEWSROOM_PUBLISH_BASE_URL=http://127.0.0.1:8082
# NEWSROOM_ADMIN_TOKEN=

# --- Telegram (the serve loop + telegram-bot-skill) ---------------------------------------
# The Telegram lane is the telegram-bot-skill sibling checkout, started by the serve loop
# (`./run.sh serve`). The two keys below cascade into it: the bridge's own .env wins when it
# has them, this file is the fallback, so one main .env can run the whole product. The
# loop's other knobs (chain order, thresholds, error patterns) live in
# automation/supervisor/supervisor.config.json, not here.
# Bot token from @BotFather (/newbot):
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id: recover mode seeds you as owner at bridge boot (no claim link).
OWNER_ID=
