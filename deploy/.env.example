# Compose environment for the brain. Copy to .env in this directory and fill in.
# These feed the `brain` service (prefix NEWSROOM_). The in-container paths
# (NEWSROOM_PERSONA_DB_PATH, NEWSROOM_PROMPTS_DIR) are set in docker-compose.yml.

# The platform publish seam (used by the bootstrap author-reconcile and the publish
# transport). The token MUST hold articles:write + articles:publish-any + admin:write
# (publish-any lets each article be authored as the persona who wrote it).
NEWSROOM_PUBLISH_BASE_URL=http://host.docker.internal:8080
NEWSROOM_OPERATOR_TOKEN=

# Presentation defaults for a fresh box (seeded into the location row on bootstrap).
# NEWSROOM_DEFAULT_REGION=AR
# NEWSROOM_DEFAULT_UI_LANG=es-419
# NEWSROOM_DEFAULT_LANGUAGE=es
# NEWSROOM_DEFAULT_GDELT_COUNTRY=AR
