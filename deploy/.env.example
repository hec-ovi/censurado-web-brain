# Compose environment for the brain. Copy to .env in this directory and fill in.
# These feed the `brain` service (prefix NEWSROOM_). The in-container paths
# (NEWSROOM_PERSONA_DB_PATH, NEWSROOM_PROMPTS_DIR) are set in docker-compose.yml.

# The platform publish seam. The token MUST hold BOTH scopes on the platform:
#   articles:write AND articles:publish-any
# (publish-any lets the harness author each article as the persona who wrote it).
NEWSROOM_PUBLISH_BASE_URL=http://host.docker.internal:8080
NEWSROOM_OPERATOR_TOKEN=
# Publish a run's ready articles together in one atomic POST /articles:batch (default on).
# Set false to fall back to one POST /articles per article.
NEWSROOM_PUBLISH_BATCH=true

# The inference backend (OpenAI Chat-Completions dialect). Either:
#  - the bundled local model: run with `--profile local-llm` and use the line below;
#  - your own endpoint: set this to it and leave the profile off.
NEWSROOM_INFERENCE_BASE_URL=http://inference:8080/v1

# Imagery seam: the art director renders a hero image per article on a local ComfyUI
# (FLUX.2 klein). Point this at your ComfyUI server (the comfyui-strix-docker box on
# :8188). Set NEWSROOM_AUTO_GENERATE_IMAGE=false to ship text-only by default (a run
# can still override with the per-run images flag).
NEWSROOM_COMFYUI_BASE_URL=http://host.docker.internal:8188
# NEWSROOM_AUTO_GENERATE_IMAGE=true
# NEWSROOM_IMAGE_WIDTH=1024
# NEWSROOM_IMAGE_HEIGHT=1024
# NEWSROOM_IMAGE_STEPS=4
# NEWSROOM_REFERENCE_IMAGE_LIMIT=2
# Where generated images are uploaded (POST /media). Defaults to the publish host above.
# NEWSROOM_MEDIA_BASE_URL=http://host.docker.internal:8080

# Loop bounds (iteration counts and a shared per-article budget; NOT output caps).
# Uncomment to override the defaults.
# NEWSROOM_N_MAX=4
# NEWSROOM_EXPRESS_N=2
# NEWSROOM_MAX_SWEEPS=4
# NEWSROOM_MAX_MANAGER_STEPS=8
# NEWSROOM_MAX_RESEARCH_STEPS=6
