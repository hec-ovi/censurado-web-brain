{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "censurado-mcp/tool-catalog.schema.json",
  "title": "MCP tools/list result",
  "description": "The catalog this layer serves. Every tool declares both an input and an output schema, so a caller never has to guess a shape.",
  "type": "object",
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "title": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "inputSchema": {"type": "object"},
          "outputSchema": {"type": "object"}
        },
        "required": ["name", "title", "description", "inputSchema", "outputSchema"],
        "additionalProperties": false
      }
    }
  },
  "required": ["tools"],
  "additionalProperties": false
}
