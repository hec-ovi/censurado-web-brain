{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "censurado-mcp/doctor-report.schema.json",
  "title": "Doctor report",
  "description": "What the doctor tool returns in structuredContent: one row per check, plus the verdict. A FAIL anywhere makes ready false.",
  "type": "object",
  "properties": {
    "ready": {
      "type": "boolean",
      "description": "True when no check failed. Warnings never make it false."
    },
    "deep": {
      "type": "boolean",
      "description": "True when the run exercised the image render, the media upload, and the deploy login for real."
    },
    "counts": {
      "type": "object",
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0}
      },
      "required": ["ok", "warn", "fail"],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "description": "Which lane the check belongs to.",
            "enum": ["config", "services", "content", "image", "media", "deploy", "recipe"]
          },
          "check": {"type": "string"},
          "level": {"type": "string", "enum": ["OK", "WARN", "FAIL"]},
          "detail": {"type": "string"}
        },
        "required": ["group", "check", "level", "detail"],
        "additionalProperties": false
      }
    },
    "summary": {"type": "string"},
    "next_action": {
      "type": "string",
      "description": "The single concrete move to make next. Present only when ready is false."
    }
  },
  "required": ["ready", "deep", "counts", "checks", "summary"],
  "additionalProperties": false
}
